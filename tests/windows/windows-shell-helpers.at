dnl -*- autotest -*-
dnl Windows test-harness shell shims for the dbosoft Windows build-smoke suite.
dnl
dnl These keep the upstream tests/*.at bodies (and ovs-macros.at / atlocal.in)
dnl UNCHANGED -- resync cost on them stays 0.  Instead of patching Windows
dnl handling back into ovs-macros.at, tests/windows-testsuite.at m4_includes this
dnl file once, at top level, so the shims land in the generated suite's preamble
dnl and are in scope for every test group.
dnl
dnl Content is the historical ovs-macros.at Windows block (pwd -W, CRLF-tolerant
dnl diff, taskkill-based kill/tskill) plus a self-contained IS_WIN32 probe so that
dnl atlocal.in needs no Windows case either.

dnl Detect Windows from the MSYS2 shell that runs the generated POSIX-sh suite.
case `uname` in
MINGW*|MSYS*) IS_WIN32=yes ;;
*)            IS_WIN32=no  ;;
esac

if test "$IS_WIN32" = "yes"; then
    pwd () {
        command pwd -W "$@"
    }

    diff () {
        command diff --strip-trailing-cr "$@"
    }

    # tskill is more effective than taskkill but it isn't always installed.
    if (tskill //?) >/dev/null 2>&1; then :; else
        tskill () { taskkill //F //PID $1 >/dev/null; }
    fi

    kill () {
        signal=
        retval=0
        for arg; do
            arg=$(echo $arg | tr -d '\n\r')
            case $arg in
            -*) signal=$arg ;;
            [1-9][0-9]*)
                # tasklist always returns 0.
                # If pid does exist, there will be a line with the pid.
                if tasklist //fi "PID eq $arg" | grep $arg >/dev/null; then
                    if test "X$signal" != "X-0"; then
                        tskill $arg
                    fi
                else
                    retval=1
                fi
                ;;
            esac
        done
        return $retval
    }
fi
