dnl ===========================================================================
dnl  dbosoft OVS — owned, Windows-reduced "build-smoke" autotest suite.
dnl
dnl  This is NOT a fork of upstream's .at bodies: it is an m4_include manifest
dnl  over UNCHANGED upstream fragments (resync cost on them = 0).  Its purpose is
dnl  to prove that the CMake/MSVC-built shipped daemons (ovsdb-server, ovs-vswitchd
dnl  with --enable-dummy, ovs-vsctl/ovs-ofctl/ovs-dpctl) link, start, talk over the
dnl  Windows named-pipe transport, and tear down cleanly on Windows — a *dozen*
dnl  lifecycle cases selected at run time via TESTSUITEFLAGS='-k ...', NOT the full
dnl  upstream logic matrix.  Exhaustive shared-"brain" logic lives in the MSYS-free
dnl  ovstest/CTest net (surface I); see datapath-windows/WINDOWS-TEST-SETUP-PLAN.md.
dnl
dnl  Run -j1 (the testsuite.patch parallel dispatcher is intentionally not applied;
dnl  it only affects -jN).  AUTOTEST_PATH points at the CMake Release/ binaries.
dnl ===========================================================================

dnl ---- macro libraries: MUST come first; they define OVS_VSWITCHD_START etc. ----
dnl Keep this set in sync with tests/testsuite.at's macro includes on resync
dnl (WINDOWS-TEST-SETUP-PLAN.md §7: comm -13 against upstream's macro includes).
m4_include([tests/ovs-macros.at])
m4_include([tests/ovsdb-macros.at])
m4_include([tests/ofproto-macros.at])

dnl ---- Windows harness shims, kept OUT of upstream ovs-macros.at (resync cost 0).
dnl Defines IS_WIN32 + the pwd/diff/kill shims the POSIX-sh suite needs on Windows.
m4_include([tests/windows/windows-shell-helpers.at])

dnl ---- Tier-S1: daemon lifecycle proof (ovsdb-server / ovs-vswitchd, named pipe).
dnl ovsdb.at is the SINGLE OVSDB entry point — it already m4_includes the whole
dnl ovsdb-*.at family.  Do NOT also include any individual ovsdb-*.at (autom4te
dnl fails on duplicate AT_SETUP/AT_BANNER).
m4_include([tests/ovsdb.at])           dnl ovsdb-server/-tool/-client over named pipe
m4_include([tests/ovs-vsctl.at])       dnl vsctl CRUD against ovsdb-server.exe
m4_include([tests/ovs-vswitchd.at])    dnl vswitchd start/stop, add-br/add-port lifecycle

dnl ---- Tier-S2: userspace library / protocol coverage that runs WITHOUT a real
dnl datapath.  Bodies stay UNCHANGED upstream; the tcp/ssl/tls/python *transport*
dnl variants (which need Windows TCP/TLS-loopback or the Python bindings) are
dnl excluded at the RUNNER via -k '!...' from tests/windows/excluded-keywords.txt,
dnl NOT by editing the .at files.  Standalone test binaries these need (test-ovsdb,
dnl test-stream, test-type-props, test-lib, test-strtok_r) are built by CMakeLists.
m4_include([tests/library.at])           dnl ovstest print/compare wrappers
m4_include([tests/heap.at])
m4_include([tests/bundle.at])
m4_include([tests/check-structs.at])
m4_include([tests/odp.at])
m4_include([tests/multipath.at])
m4_include([tests/vconn.at])
m4_include([tests/aes128.at])
m4_include([tests/uuid.at])
m4_include([tests/json.at])
m4_include([tests/jsonrpc.at])
m4_include([tests/lockfile.at])
m4_include([tests/reconnect.at])
m4_include([tests/ofp-util.at])
m4_include([tests/ofp-errors.at])
m4_include([tests/vlog.at])
m4_include([tests/auto-attach.at])

dnl ---- DEFERRED: need a real forwarding datapath (the dummy/userspace path can't
dnl satisfy them on Windows -- some hang waiting on packet forwarding), or are
dnl golden-diff/format suites that fail wholesale.  Kept OUT of the CI gate; run
dnl manually for datapath triage once the kernel-driver forwarding path lands.
dnl This is a manifest SELECTION (our file), not a Win32-tag edit to upstream tests.
dnl   ofproto.at ofproto-dpif.at      : flow xlate / dpif features on dummy dp
dnl   bridge.at dpctl.at daemon.at    : bridge wiring / dpctl / daemon over real dp
dnl   stp.at rstp.at bfd.at cfm.at    : L2 control protocols (need forwarding)
dnl   lacp.at mcast-snooping.at       : bonding / multicast snooping (need forwarding)
dnl   learn.at learning-switch.at     : learn action / OpenFlow learning switch
dnl   netdev-type.at packet-type-aware.at drop-stats.at : netdev / ptap / drop stats
dnl   classifier.at                   : test-classifier subcases failing on Windows
dnl   ofp-actions.at ofp-print.at ovs-ofctl.at mpls-xlate.at nsh.at : OF action/print
dnl                                     golden-diff suites

dnl ---- EXCLUDED for good (documented, NOT a Win32-tag filter) -------------------
dnl   system-*.at                  : Linux kernel / netns / veth / tcpdump
dnl   dpif-netdev.at, pmd.at, alb.at: DPDK/PMD userspace datapath (Linux-shaped)
dnl   tunnel*.at, ovs-router.at    : Linux tunnel / route-table
dnl   vtep-ctl.at                  : needs vtep-ctl.exe (not built — own VTEP IDL)
dnl   checkpatch.at, completion.at : git/style + bash-completion tooling
dnl   fuzz-regression.at           : large fuzz corpus, slow
dnl   *-py.at, pytest.at           : python test harness (revisit as a -py wave)
